{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"moduleResolution": "bundler"
	},
	// `$app/tsconfig` is written into node_modules by `svelte-kit sync` and carries no `include`, so
	// this file names what gets checked: the same set SvelteKit 2's generated
	// `.svelte-kit/tsconfig.json` covered. `allowImportingTsExtensions`, which every `#lib/....ts`
	// specifier needs, comes from `$app/tsconfig` itself.
	"include": ["src", "tests", "vite.config.ts"],
	"exclude": ["node_modules", "src/service-worker", "src/service-worker.*"]
}
