{
	"name": "sistem-informasi-manajemen-keuangan",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie --strategy baseLocale --emit-ts-declarations",
		"check": "bun run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bun run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "bun run paraglide:compile && prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "bun run paraglide:compile && vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright install chromium && playwright test",
		"db:generate": "drizzle-kit generate && prettier --write drizzle",
		"db:migrate": "drizzle-kit migrate",
		"db:push-local-experiment": "drizzle-kit push",
		"superuser:grant": "bun run scripts/grant-superuser.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@inlang/paraglide-js": "2.25.4",
		"@lucide/svelte": "^1.46.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@types/pg": "8.23.1",
		"@types/sanitize-html": "2.16.1",
		"clsx": "^2.1.1",
		"drizzle-kit": "0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.6.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@sinclair/typebox": "^0.34.15",
		"better-auth": "1.7.5",
		"drizzle-orm": "0.45.2",
		"elysia": "^1.4.30",
		"marked": "18.0.13",
		"nodemailer": "^10.0.10",
		"pg": "8.23.0",
		"sanitize-html": "2.17.7"
	}
}
