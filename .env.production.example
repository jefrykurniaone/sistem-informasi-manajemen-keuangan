# Copy this file to `.env` on the server, next to docker-compose.prod.yml, and fill in every empty
# value. Nothing here is a real secret: the secret lines are empty on purpose, and the rest are
# examples to replace. The file is read twice: by `docker compose` itself, for the ${...} values
# in docker-compose.prod.yml, and as `env_file` by the `app` service.

# --- Image --------------------------------------------------------------------
# The tag of ghcr.io/jefrykurniaone/sistem-informasi-manajemen-keuangan that `migrate` and `app`
# run. Read by docker compose only. Pin it to a released tag rather than leaving `latest`, so
# the image that runs is the one that was tested.
APP_TAG=latest

# The complex name (PUBLIC_COMPLEX_NAME) does not belong here: it is frozen into the image at
# build time through `$env/static/public`, so it is passed as a build arg when the image is
# built (`--build-arg PUBLIC_COMPLEX_NAME=...`), and setting it on the server changes nothing.

# --- Address ------------------------------------------------------------------
# The public host name Caddy answers on and obtains a TLS certificate for. Read by the Caddyfile.
SITE_ADDRESS=komplek.example.com
# The address the application answers on: SITE_ADDRESS with https:// in front. adapter-node
# checks form posts against it and better-auth builds every emailed link against it, so a
# mismatch rejects every form and sends links that do not open.
ORIGIN=https://komplek.example.com
# adapter-node listens on port 3000 (its PORT default), which is the port the Caddyfile proxies
# to. ADDRESS_HEADER and XFF_DEPTH are also read by adapter-node, but they describe the Caddy
# topology rather than one deployment, so docker-compose.prod.yml sets them and they are not here.

# `@sveltejs/adapter-node` defaults this to 512K and rejects a larger request body with a bare 413,
# before any readable message. Keep it above three times the per-file upload cap plus overhead for
# multipart headers and other form fields, as in .env.example.
BODY_SIZE_LIMIT=16M

# --- Database -----------------------------------------------------------------
# The Supabase session pooler (port 5432, not the transaction pooler on 6543), used by the app and
# by the `migrate` service. Copy the user, host and password from the Supabase dashboard.
#
# Do not use `?sslmode=require` on its own. pg 8.23.0 with pg-connection-string 2.14.0 treats
# `require` as an alias for `verify-full` (it only prints a deprecation warning), so it checks
# the server certificate against the public root store, and the pooler's certificate
# (*.pooler.supabase.com) is issued by "Supabase Intermediate 2021 CA" under "Supabase Root 2021
# CA", Supabase's own CA, which no public store carries. The connection fails with
# SELF_SIGNED_CERT_IN_CHAIN, under Node and under Bun alike.
#
# So the URL names that CA with `sslrootcert`, which pg reads from disk and trusts instead:
# download the certificate from the Supabase dashboard (Database settings, SSL Configuration) and
# save it on the server as certs/supabase-ca.crt, next to docker-compose.prod.yml, which mounts
# that directory at /app/certs. `verify-full` is written out rather than `require` because it
# keeps its meaning when pg 9 moves `require` to the weaker libpq semantics.
DATABASE_URL=postgres://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/app/certs/supabase-ca.crt
# Fallback only, when the CA file cannot be put in place: `uselibpqcompat=true&sslmode=require`
# gives libpq's meaning of `require`, an encrypted connection whose certificate is not checked.
# It works against the pooler, but anyone who can intercept the connection can impersonate it.
# DATABASE_URL=postgres://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require

# --- Authentication -----------------------------------------------------------
# Signs every session token, email verification link and password reset link. At least 32
# characters, and never the value from .env.example. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- File storage -------------------------------------------------------------
# Where uploaded files are written, relative to /app inside the container. docker-compose.prod.yml
# mounts ./storage from the server at /app/storage, so keep this at `storage` or the files land
# inside the container and are lost with it.
FILE_STORE_ROOT=storage
# Signs the download links the application hands out. At least 32 characters, generated the same
# way as BETTER_AUTH_SECRET, and different from it.
FILE_STORE_SECRET=

# --- Mail ---------------------------------------------------------------------
# The mail provider's SMTP server. The client does not open the connection inside TLS but upgrades
# with STARTTLS whenever the server offers it, so use the provider's submission port (587).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# The provider login. The application does not read these two yet: the SMTP sender in
# src/lib/server/ports/email.ts sends without authentication until the change that adds it.
# They are listed so the server's .env already carries them when it lands.
SMTP_USER=
SMTP_PASS=
# The sender address on every outgoing message. The provider has to accept it for its domain.
EMAIL_FROM=no-reply@komplek.example.com
