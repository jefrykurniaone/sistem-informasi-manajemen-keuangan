# Copy this file to `.env` before running `docker compose up`.
# There are no real secrets here; every value is local to one machine.

# --- Application ------------------------------------------------------------
# The port the application is served on: http://localhost:5173
APP_PORT=5173
# The origin SvelteKit uses to check form requests.
ORIGIN=http://localhost:5173
# Set to `true` when file changes are not picked up inside the container
# (bind mounts on Windows and macOS sometimes need polling).
VITE_USE_POLLING=false
# `@sveltejs/adapter-node` defaults this to 512K and rejects a larger request body with a bare
# 413, below the service layer and before any readable message. `vite dev` does not enforce this
# limit at all, so an oversized request passes every check in development and only fails once the
# built adapter-node server serves it. Keep this above three times the per-file upload cap plus
# overhead for multipart headers, filenames and other form fields — lowering one without the other
# brings the defect back.
BODY_SIZE_LIMIT=16M

# --- Authentication ---------------------------------------------------------
# Signs every session token, every email verification link, and every password
# reset link. Anyone holding it can mint a session for any account, so replace the
# placeholder below with a value of your own:
#   openssl rand -base64 32
# It has to be at least 32 characters, and it never leaves the server.
# The address better-auth builds those links against is ORIGIN above; there is no
# second variable for it, so the two cannot disagree.
BETTER_AUTH_SECRET=rahasia-lokal-ganti-saya-dengan-openssl-rand-base64-32

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=komplek
POSTGRES_PASSWORD=kata-sandi-lokal-ganti-saya
POSTGRES_DB=komplek
# The PostgreSQL port on the host machine, so it can be opened with psql or a GUI.
# Change it when something else on this machine already answers on 5432 — a native
# PostgreSQL service is the usual culprit, and it answers before the container does.
POSTGRES_PORT=5432

# The database URL as seen from the host machine — used by `drizzle-kit`
# (`bun run db:generate`, `bun run db:migrate`) and by `bun run dev` without Docker.
# The host name is `localhost`, not `db`: the `app` service in docker-compose.yml
# builds its own URL with the host name `db` and does not read this line.
DATABASE_URL=postgres://komplek:kata-sandi-lokal-ganti-saya@localhost:5432/komplek

# The database `bun run test` uses. It must be set, and it must differ from
# DATABASE_URL: the test harness creates and drops schemas, so it refuses to run
# against the development server's database. The database is created on the first
# test run when it does not exist, so `docker compose up db` followed by
# `bun run test` is enough. Every test file gets one clean PostgreSQL schema inside it.
TEST_DATABASE_URL=postgres://komplek:kata-sandi-lokal-ganti-saya@localhost:5432/komplek_test

# --- Mailpit ----------------------------------------------------------------
# The web interface that catches outgoing mail: http://localhost:8025
MAILPIT_WEB_PORT=8025
# The Mailpit SMTP port on the host machine.
MAILPIT_SMTP_PORT=1025

# The mail server as seen from the host machine — used by `bun run dev` and `bun run test`
# running directly on this machine. The host name is `localhost`, not `mailpit`: the `app`
# service in docker-compose.yml writes its own `mailpit` host name and does not read these
# two lines. Keep SMTP_PORT equal to MAILPIT_SMTP_PORT above; they are the two halves of
# the same published port.
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=no-reply@komplek.local

# SMTP_USER and SMTP_PASS are optional. Leave both empty to keep sending to Mailpit as above,
# with no authentication. Set both together to authenticate against a real provider; the moment
# both are set, STARTTLS is required rather than merely offered. Setting only one of the two is
# a configuration error and fails at startup, naming the one that is missing.
#
# Example for Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your-account@gmail.com
#   SMTP_PASS=<an app password, not your account password>
# Gmail rejects a From address that is not the account you authenticated as, so EMAIL_FROM above
# has to be the same address as SMTP_USER.
SMTP_USER=
SMTP_PASS=

# --- File storage -----------------------------------------------------------
# Where uploaded files are written, relative to the repository root. The directory is in
# .gitignore and is created on the first write.
FILE_STORE_ROOT=storage
# Signs the download links the application hands out, and is the only thing stopping anyone
# from minting a link to any file. Replace the placeholder below with a value of your own:
#   openssl rand -base64 32
# It has to be at least 32 characters, and it never leaves the server.
FILE_STORE_SECRET=rahasia-lokal-ganti-saya-dengan-openssl-rand-base64-32

# --- Complex ----------------------------------------------------------------
# The name of the housing complex, shown as the sidebar brand, in the header of the public pages
# and at the end of every tab title ("Judul halaman - Nama komplek"). Leave it empty to show
# "Komplek". It is read through `$env/static/public`, so it is baked in at build time: changing it
# means building again, and the line has to exist (even empty) or `bun run check` and
# `bun run build` refuse with "has no exported member 'PUBLIC_COMPLEX_NAME'". It is public by
# design: never put anything secret here.
PUBLIC_COMPLEX_NAME=
