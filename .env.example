# Salin berkas ini menjadi `.env` sebelum menjalankan `docker compose up`.
# Tidak ada nilai rahasia sungguhan di sini; semuanya khusus mesin lokal.

# --- Aplikasi ---------------------------------------------------------------
# Porta tempat aplikasi dibuka di peramban: http://localhost:5173
APP_PORT=5173
# Alamat asal yang dipakai SvelteKit untuk memeriksa permintaan form.
ORIGIN=http://localhost:5173
# Isi `true` kalau perubahan berkas tidak terdeteksi di dalam container
# (bind mount di Windows dan macOS kadang butuh polling).
VITE_USE_POLLING=false

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=komplek
POSTGRES_PASSWORD=kata-sandi-lokal-ganti-saya
POSTGRES_DB=komplek
# Porta PostgreSQL di mesin host, supaya bisa dibuka dengan psql atau GUI.
POSTGRES_PORT=5432

# Alamat basis data dari sudut pandang mesin host — dipakai `drizzle-kit`
# (`bun run db:generate`, `bun run db:migrate`) dan `bun run dev` tanpa Docker.
# Nama hostnya `localhost`, bukan `db`: layanan `app` di docker-compose.yml
# menyusun alamatnya sendiri dengan nama host `db` dan tidak membaca baris ini.
DATABASE_URL=postgres://komplek:kata-sandi-lokal-ganti-saya@localhost:5432/komplek

# Basis data yang dipakai `bun run test`. Wajib diisi dan wajib berbeda dari
# DATABASE_URL: perkakas uji membuat dan menghapus skema, jadi ia menolak
# berjalan di atas basis data server pengembangan. Basis datanya dibuat sendiri
# pada pengujian pertama kalau belum ada, jadi `docker compose up db` lalu
# `bun run test` sudah cukup. Setiap berkas pengujian mendapat satu skema
# PostgreSQL bersih di dalamnya.
TEST_DATABASE_URL=postgres://komplek:kata-sandi-lokal-ganti-saya@localhost:5432/komplek_test

# --- Mailpit ----------------------------------------------------------------
# Antarmuka web penangkap email: http://localhost:8025
MAILPIT_WEB_PORT=8025
# Porta SMTP Mailpit di mesin host.
MAILPIT_SMTP_PORT=1025
# Nama host `mailpit` adalah nama layanan di docker-compose.yml.
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=no-reply@komplek.local
