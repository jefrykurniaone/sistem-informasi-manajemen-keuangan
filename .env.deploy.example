# Local settings for scripts/setup-env.sh and scripts/deploy.sh, which run from WSL Ubuntu on the
# developer machine. Copy this file to `.env.deploy` in the repository root and fill it in.
# `.env.deploy` is ignored by git and holds no secret: the SSH key is named by its path only, and
# the application's secrets go straight to the VM through the setup-env.sh wizard. The values below
# are documentation examples (RFC 5737 addresses, a made-up key path), not a real server.
#
# One NAME=value per line, no comment on the same line. The scripts read this file as data rather
# than running it as shell code, so quotes are optional, and a leading `~/` in a path means the
# home directory in WSL.

# The SSH host of the VM: its static IP, or a host name that resolves to it.
VM_HOST=203.0.113.10

# The SSH user on the VM. Ubuntu images on Lightsail use `ubuntu`.
VM_USER=ubuntu

# The private key (.pem) Lightsail issued for the instance. Keep it on the WSL file system, not
# under /mnt/c or /mnt/d, where its mode cannot be narrowed and ssh refuses it, and keep it outside
# this repository, whose whole tree is the docker build context: `chmod 600 ~/.ssh/komplek-uji.pem`.
VM_SSH_KEY=~/.ssh/komplek-uji.pem

# The static public IPv4 address attached to the instance. SITE_ADDRESS and ORIGIN are derived from
# it: the application answers on https://<ip>.sslip.io.
VM_STATIC_IP=203.0.113.10

# The complex name frozen into the image at build time (the PUBLIC_COMPLEX_NAME build arg). Changing
# it takes a new deploy; setting it on the server changes nothing.
PUBLIC_COMPLEX_NAME=Komplek Contoh
